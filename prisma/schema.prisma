// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

// Note that some adapters may set a maximum length for the String type by default, please ensure your strings are long
// enough when changing adapters.
// See https://www.prisma.io/docs/orm/reference/prisma-schema-reference#string for more information
datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Session {
  id            String    @id
  shop          String
  state         String
  isOnline      Boolean   @default(false)
  scope         String?
  expires       DateTime?
  accessToken   String
  userId        BigInt?
  firstName     String?
  lastName      String?
  email         String?
  accountOwner  Boolean   @default(false)
  locale        String?
  collaborator  Boolean?  @default(false)
  emailVerified Boolean?  @default(false)
  refreshToken        String?
  refreshTokenExpires DateTime?
}

model HreflangGroup {
  id              Int       @id @default(autoincrement())
  hreflangId      String?   @unique
  resourceType    String
  status          String
  matchCriteria   String?
  matchConfidence Int?
  createdAt       DateTime  @default(now())
  firstMatchAt    DateTime?
  completedAt     DateTime?
  items           HreflangItem[]
  logs            MatchingLog[]
}

model HreflangItem {
  id         Int           @id @default(autoincrement())
  groupId    Int
  group      HreflangGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  storeId    String
  shopDomain String
  shopifyGid String
  handle     String
  url        String
  sku        String?
  title      String
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt

  @@unique([groupId, storeId])
  @@unique([storeId, shopifyGid])
  @@index([sku])
  @@index([storeId, handle])
}

model AppSetting {
  key   String @id
  value String
}

model MatchingLog {
  id        Int            @id @default(autoincrement())
  groupId   Int?
  group     HreflangGroup? @relation(fields: [groupId], references: [id], onDelete: SetNull)
  action    String
  details   Json?
  createdAt DateTime       @default(now())
}
