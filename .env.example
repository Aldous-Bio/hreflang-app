# PostgreSQL connection string (Supabase). Required by Prisma.
DATABASE_URL="postgresql://user:password@host:5432/postgres"

# JSON array describing the 4 hreflang stores. shopDomain must be the
# *.myshopify.com domain (the value webhooks report in `shop`), not the
# custom domain. publicUrl is used to build the hreflang <link> URLs.
STORE_MAP=[{"storeId":"main-es","shopDomain":"CHANGE-ME-es.myshopify.com","locale":"es","publicUrl":"https://aldousbio.com"},{"storeId":"main-it","shopDomain":"CHANGE-ME-it.myshopify.com","locale":"it","publicUrl":"https://aldousbio.it"},{"storeId":"main-pt","shopDomain":"CHANGE-ME-pt.myshopify.com","locale":"pt","publicUrl":"https://aldousbio.pt"},{"storeId":"main-fr","shopDomain":"CHANGE-ME-fr.myshopify.com","locale":"fr","publicUrl":"https://aldousbio.fr"}]
